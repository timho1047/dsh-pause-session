{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/client/css-modules.d.ts",
    "src/client/index.tsx",
    "src/client/locales.ts"
  ]
}
